## <summary>Brave browser</summary>

#######################################
## <summary>
## 	Role access for brave
## </summary>
## <param name="role_prefix">
##	<summary>
##	The prefix of the user role (e.g., user
##	is the prefix for user_r).
##	</summary>
## </param>
## <param name="user_domain">
##	<summary>
##	User domain for the role.
##	</summary>
## </param>
## <param name="user_exec_domain">
##	<summary>
##	User exec domain for execute and transition access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access
##	</summary>
## </param>
#
template(`brave_role',`
	gen_require(`
		type brave_t;
		type brave_sandbox_t;
		type brave_naclhelper_t;
		class dbus send_msg;
	')

	role $4 types brave_t;
	role $4 types brave_sandbox_t;
	role $4 types brave_naclhelper_t;

	# Transition from the user domain to the derived domain
	brave_domtrans($3)

	# Allow ps to show brave processes and allow the user to signal it
	ps_process_pattern($3, brave_t)

	allow $3 brave_t:process signal_perms;
	allow $3 brave_sandbox_t:process signal_perms;
	allow $3 brave_naclhelper_t:process signal_perms;
	allow brave_t $3:process { signal signull };
	allow brave_t $3:unix_stream_socket { read write };

	allow $2 brave_t:fifo_file write;

	allow $3 brave_t:unix_stream_socket connectto;

	# for /tmp/.ICE-unix/* sockets
	allow brave_t $3:unix_stream_socket connectto;

	allow brave_sandbox_t $3:fd use;
	allow brave_naclhelper_t $3:fd use;

	allow $3 brave_t:dbus send_msg;
	allow brave_t $3:dbus send_msg;

	optional_policy(`
		systemd_user_app_status($1, brave_t)
	')
')

#######################################
## <summary>
##	Read-write access to Braves' temporary fifo files
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access
##	</summary>
## </param>
#
interface(`brave_rw_tmp_pipes',`
	gen_require(`
		type brave_tmp_t;
	')

	rw_fifo_files_pattern($1, brave_tmp_t, brave_tmp_t)
')

##############################################
## <summary>
##	Automatically use the specified type for resources created in brave's
##	temporary locations
## </summary>
## <param name="domain">
##	<summary>
##	Domain that creates the resource(s)
##	</summary>
## </param>
## <param name="private_type">
##	<summary>
##	Private file type.
##	</summary>
## </param>
## <param name="class">
##	<summary>
##	Type of the resource created
##	</summary>
## </param>
## <param name="filename" optional="true">
##	<summary>
##	The name of the resource being created
##	</summary>
## </param>
#
interface(`brave_tmp_filetrans',`
	gen_require(`
		type brave_tmp_t;
	')

	search_dirs_pattern($1, brave_tmp_t, brave_tmp_t)
	filetrans_pattern($1, brave_tmp_t, $2, $3, $4)
')

#######################################
## <summary>
## 	Execute a domain transition to the brave domain (brave_t)
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access
##	</summary>
## </param>
#
interface(`brave_domtrans',`
	gen_require(`
		type brave_t;
		type brave_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, brave_exec_t, brave_t)
')

#######################################
## <summary>
## 	Execute brave in the brave domain and allow the specified role to access the brave domain
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access
##	</summary>
## </param>
#
interface(`brave_run',`
	gen_require(`
		type brave_t;
	')

	brave_domtrans($1)
	role $2 types brave_t;
')
