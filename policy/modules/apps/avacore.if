## <summary>Avabase/Lyra - local AI companion (FastAPI core service + Discord client).</summary>

########################################
## <summary>
##	Execute the Avabase core service in the avacore_t domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to transition.
##	</summary>
## </param>
#
interface(`avacore_domtrans',`
	gen_requires(`
		type avacore_t, avacore_exec_t;
	')

	domtrans_pattern($1, avacore_exec_t, avacore_t)
')

########################################
## <summary>
##	Execute the Avabase Discord client in the avacore_discord_t domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to transition.
##	</summary>
## </param>
#
interface(`avacore_discord_domtrans',`
	gen_requires(`
		type avacore_discord_t, avacore_discord_exec_t;
	')

	domtrans_pattern($1, avacore_discord_exec_t, avacore_discord_t)
')
